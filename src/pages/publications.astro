---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PublicationList from '~/components/PublicationList.astro';
import { getPublications } from '~/lib/content';
import { withBase } from '~/lib/paths';
const publications = await getPublications();
const years = [...new Set(publications.map(({ data }) => data.year))];
---
<BaseLayout title="Publications | Stephen Steinle" description="Publications by Stephen Steinle on strategic reasoning, cognitive modeling, legal NLP, fatigue, and code generation.">
  <h1>Publications</h1>
  <ul class="inline-links page-intro">
    <li><a href="https://scholar.google.com/citations?user=lN4H6FoAAAAJ&hl=en">Google Scholar</a></li>
    <li><a href={withBase('/publications.bib')} download>Download BibTeX</a></li>
  </ul>
  {years.map((year) => (
    <section class="page-section" aria-labelledby={'year-' + year}>
      <h2 id={'year-' + year}>{year}</h2>
      <PublicationList publications={publications.filter(({ data }) => data.year === year)} />
    </section>
  ))}
</BaseLayout>
