---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { termLabel } from '~/lib/content';
const courses = (await getCollection('teaching', ({ data }) => !data.draft)).sort((a, b) => b.data.term.localeCompare(a.data.term));
---
<BaseLayout title="Teaching | Stephen Steinle" description="Stephen Steinle's teaching assistant appointments at the University of South Florida.">
  <h1>Teaching</h1>
  <ul class="entry-list">
    {courses.map(({ id, data }) => (
      <li id={id}>
        <article>
          <p class="eyebrow">{termLabel(data.term)}</p>
          <h2>{data.course}</h2>
          <p class="entry-description">{data.role}</p>
          <p class="entry-meta">{data.institution}</p>
        </article>
      </li>
    ))}
  </ul>
</BaseLayout>
