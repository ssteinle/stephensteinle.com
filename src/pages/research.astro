---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getPublications } from '~/lib/content';
import { withBase } from '~/lib/paths';
const areas = (await getCollection('research', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const publications = new Map((await getPublications()).map((p) => [p.id, p.data]));
const projects = await getCollection('projects', ({ data }) => !data.draft);
---
<BaseLayout title="Research | Stephen Steinle" description="Research in conversational strategic reasoning, persona evaluation, cognitive modeling, legal retrieval, and constrained code generation.">
  <h1>Research</h1>
  <p class="page-intro prose">I study reasoning in people and language models, with an emphasis on strategic interaction, cognitive traits, and the evidence behind a decision.</p>
  {areas.map(({ id, data }) => (
    <section id={id} class="page-section prose">
      <h2>{data.title}</h2>
      <p class="research-question">{data.question}</p>
      <p>{data.description}</p>
      <ul class="related-list">
        {data.publications.map((ref) => {
          const paper = publications.get(ref.id);
          return paper && <li><a href={withBase('/publications') + '#' + ref.id}>{paper.title}</a></li>;
        })}
      </ul>
      <ul class="inline-links">
        {projects.filter((p) => p.data.research?.id === id).map((p) => <li><a href={withBase('/projects') + '#' + p.id}>{p.data.name}</a></li>)}
      </ul>
    </section>
  ))}
</BaseLayout>
<style>
  .research-question { font-weight: 600; margin-block: 1rem; }
  .related-list { margin-top: 1rem; padding-left: 1.25rem; }
  .related-list li + li { margin-top: 0.5rem; }
</style>
