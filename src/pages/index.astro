---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import SectionHeading from '~/components/SectionHeading.astro';
import SocialLinks from '~/components/SocialLinks.astro';
import PublicationList from '~/components/PublicationList.astro';
import ProjectList from '~/components/ProjectList.astro';
import { SITE, AFFILIATION } from '~/consts';
import profile from '~/data/profile.json';
import { withBase } from '~/lib/paths';
import { getPublications } from '~/lib/content';
const publications = (await getPublications()).filter(({ data }) => data.selected);
const research = (await getCollection('research', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects', ({ data }) => !data.draft && data.selected)).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title={SITE.homeTitle}>
  <section class="hero">
    <p class="eyebrow">Natural Language Processing &middot; Cognitive Modeling</p>
    <h1>{profile.name}</h1>
    <p class="descriptor">{profile.role}</p>
    <ul class="affiliation">
      <li>{AFFILIATION.lab}</li>
      <li>{AFFILIATION.college}</li>
      <li>{AFFILIATION.university} &middot; {profile.location}</li>
    </ul>
    <SocialLinks includeCv />
    <div class="bio prose">{profile.bio.map((paragraph) => <p>{paragraph}</p>)}</div>
  </section>
  <section class="page-section">
    <SectionHeading title="Research" href={withBase('/research')} linkLabel="All research" />
    <ul class="research-links">
      {research.map(({ id, data }) => <li><a href={withBase('/research') + '#' + id}>{data.title}</a></li>)}
    </ul>
  </section>
  <section class="page-section">
    <SectionHeading title="Selected Publications" href={withBase('/publications')} linkLabel="All publications" />
    <PublicationList publications={publications} compact />
  </section>
  <section class="page-section">
    <SectionHeading title="Selected Projects" href={withBase('/projects')} linkLabel="All projects" />
    <ProjectList projects={projects} />
  </section>
</BaseLayout>
<style>
  .hero h1 { margin-block: 0.5rem; font-size: 2.35rem; }
  .descriptor { font-size: 1.125rem; }
  .affiliation { margin-block: 1.25rem; padding: 0; list-style: none; color: var(--text-muted); font-size: 0.95rem; }
  .bio { margin-top: 1.5rem; }
  .bio p + p { margin-top: 1rem; }
  .research-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: 1rem 2rem; padding-left: 1.25rem; }
</style>
